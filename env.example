ADMIN_USERNAME=your@gmail.com
ADMIN_PASSWORD=password

SESSION_SECRET=a_very_long_secure_random_string_for_jwt_signing

# --- Vercel Blob (for persistent file storage in production) ---
# Required for profile photo / resume uploads to persist on Vercel
# Get this from: Vercel Dashboard → Storage → Create Blob Store → .env.local tab
BLOB_READ_WRITE_TOKEN=

# --- Upstash Redis (REQUIRED for saving changes on Vercel) ---
# On Vercel, the local filesystem is read-only. Upstash Redis stores your CMS updates.
# Connect in Vercel: Vercel Dashboard → Your Project → Storage → Connect Upstash Redis
# Or create free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Alternative names also supported:)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

